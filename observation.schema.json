{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LIB-001-A0/LIBERTY-FIN/observation.schema.json",
  "title": "LIBERTY-FIN Observation Schema",
  "description": "LIBERTY-FIN 분석 프레임워크의 첩보 관측 데이터 구조. 공개정보·로그·API 응답에서 수집된 이산 신호를 상태공간 그래프의 노드·엣지로 표현한다. 실제 침투·탈취·무단접근을 포함하지 않는다.",
  "version": "0.2.0",
  "status": "design-specification",
  "type": "object",
  "required": ["observation_id", "source", "observed_at", "type", "content"],
  "properties": {
    "observation_id": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["kind", "identifier"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["public-disclosure", "job-posting", "tender-notice", "patent", "incident-report", "press-release", "api-response", "system-log", "config-file", "documentation"]
        },
        "identifier": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "access_authorized": { "type": "boolean" },
        "authorized_by": { "type": "string" },
        "authorization_ref": { "type": "string" }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "collected_at": { "type": "string", "format": "date-time" },
    "type": {
      "type": "string",
      "enum": ["fact", "inference", "hypothesis", "counterexample"]
    },
    "content": {
      "type": "object",
      "required": ["raw", "summary"],
      "properties": {
        "raw": { "type": "string" },
        "summary": { "type": "string" },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["organization", "system", "account", "session", "api", "token", "policy", "vendor", "technology", "person", "event", "location"]
              }
            }
          }
        },
        "identifiers": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "provenance": {
      "type": "object",
      "properties": {
        "collector": { "type": "string" },
        "method": { "type": "string" },
        "chain": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance_hash": { "type": "string" },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "relation", "status"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "relation": {
            "type": "string",
            "enum": ["owns", "operates", "authenticates", "authorizes", "reads", "writes", "delegates", "inherits", "connects", "depends-on", "contracts-with", "causes"]
          },
          "status": {
            "type": "string",
            "enum": ["OBSERVED", "INFERRED", "CONTESTED", "REJECTED", "UNKNOWN"]
          },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "valid_from": { "type": "string", "format": "date-time" },
          "valid_to": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "system_state": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["public", "dmz", "internal", "isolated-testbed", "unknown"]
        },
        "interaction_level": {
          "type": "string",
          "enum": ["passive-observation", "read-only", "authorized-test", "none"]
        }
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "recorded": { "type": "boolean", "const": true },
        "recorded_at": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      }
    },
    "deletion_event": {
      "type": ["object", "null"],
      "properties": {
        "occurred_at": { "type": "string", "format": "date-time" },
        "target": { "type": "string" },
        "declared_reason": { "type": "string" },
        "observed_effects": { "type": "array", "items": { "type": "string" } },
        "reference_preserved": { "type": "boolean" }
      }
    },
    "failure_node": {
      "type": ["object", "null"],
      "properties": {
        "attempted": { "type": "string" },
        "result": {
          "type": "string",
          "enum": ["connection-refused", "forbidden", "not-found", "timeout", "rejected", "unknown"]
        },
        "reusable_as": { "type": "string" }
      }
    }
  }
}
