{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aop-fin/observation.schema.json",
  "title": "AOP-FIN observation bundle v1",
  "description": "Synthetic or redacted observations only; no credentials or exploit payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "environment",
        "approved_by",
        "approved_at"
      ],
      "properties": {
        "scope_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,80}$"
        },
        "environment": {
          "enum": [
            "SYNTHETIC",
            "ISOLATED_LAB",
            "AUTHORIZED_TESTBED"
          ]
        },
        "approved_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/observation"
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,120}$"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "observed_at",
        "stage",
        "event_type",
        "evidence_status",
        "subject_ref",
        "source",
        "evidence_refs",
        "summary",
        "authorized_scope_id"
      ],
      "properties": {
        "observation_id": {
          "$ref": "#/$defs/ref"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "stage": {
          "enum": [
            "OBSERVE",
            "FUSE",
            "MAP",
            "ATTACK_MAP",
            "RECONSTRUCT",
            "EXPAND"
          ]
        },
        "event_type": {
          "enum": [
            "API_RESPONSE",
            "SESSION_STATE",
            "AUTHZ_DECISION",
            "CONNECTION_REFUSED",
            "HTTP_403",
            "HTTP_404",
            "RESOURCE_DELETED",
            "GRAPH_UPDATED",
            "HYPOTHESIS_REVISED",
            "CONTROL_VERIFIED",
            "OTHER"
          ]
        },
        "evidence_status": {
          "enum": [
            "OBSERVED",
            "INFERRED",
            "CONTESTED",
            "REJECTED",
            "UNKNOWN"
          ]
        },
        "subject_ref": {
          "$ref": "#/$defs/ref"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_type",
            "source_ref"
          ],
          "properties": {
            "source_type": {
              "enum": [
                "SYNTHETIC_LOG",
                "REDACTED_LOG",
                "PUBLIC_DOCUMENT",
                "LAB_API_RESPONSE",
                "ANALYST_NOTE"
              ]
            },
            "source_ref": {
              "$ref": "#/$defs/ref"
            }
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "authorized_scope_id": {
          "$ref": "#/$defs/ref"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reviewer": {
          "type": "string",
          "maxLength": 120
        },
        "metadata": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    }
  }
}
